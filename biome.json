{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
  "organizeImports": { "enabled": true },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/coverage/**",
      "**/.lending-mind/**",
      "**/node_modules/**",
      "**/.omx/**",
      "**/.turbo/**",
      "**/.next/**",
      "**/.tools/**",
      "**/.lmp/**",
      "**/.source/**",
      "**/target/**",
      "lmp-test-results/**",
      ".lmp-real-world-work/**",
      "lmp_test_bed/**",
      "crates/**",
      "orchestrator/**",
      "registry/**",
      "packages/create-lmp/**",
      "test-fixtures/oss/**",
      "public/**"
    ]
  }
}
