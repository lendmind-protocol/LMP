{
  "$schema": "https://lmp-six.vercel.app/schema/mind-v1.json",
  "specVersion": "1.0",
  "id": "lmp:mind:node-onboarding-safety",
  "version": "1.0.0",
  "metadata": { "sourceRuleContractVersion": "1" },
  "name": "Node Onboarding Safety",
  "description": "Node onboarding, template rendering, non-overwrite behavior, and package resolution.",
  "modeDefaults": {
    "validation": "advisory",
    "network": "offline"
  },
  "author": {
    "kind": "official-maintainer",
    "displayName": "Lending-Mind Protocol Maintainers",
    "verified": false,
    "website": null
  },
  "provenance": {
    "sources": [
      {
        "title": "LMP repository implementation and tests",
        "url": "https://github.com/lendmind-protocol/LMP",
        "licenseNote": "Repository implementation reference; no external endorsement claimed.",
        "sourceType": "implementation",
        "accessMethod": "local-checkout",
        "contentDigest": null,
        "retentionPolicy": "metadata-only",
        "allowedUse": "evaluate-local-implementation",
        "evidenceTier": "implementation",
        "rights": "project-source"
      }
    ],
    "attributionRequired": false
  },
  "philosophy": {
    "principles": [
      "Node onboarding, template rendering, non-overwrite behavior, and package resolution.",
      "Report unsupported scope instead of silently passing it."
    ],
    "tradeoffs": [
      "A complexity cap can require more small functions and explicit error paths.",
      "Static evidence is bounded and does not replace human review."
    ],
    "decisionRules": [
      "Handle errors at the boundary where recovery is possible.",
      "Require evidence before quality, security, or performance claims."
    ],
    "antiPatterns": [
      "RAW_MACRO_EXPANSION",
      "UNHANDLED_ERROR",
      "UNBOUNDED_COMMAND_OUTPUT",
      "UNREDACTED_ARTIFACT"
    ]
  },
  "capabilities": {
    "languages": [
      "rust",
      "python",
      "typescript",
      "javascript"
    ],
    "requiredAgentTools": [
      "read_file",
      "write_file",
      "execute_command",
      "search"
    ]
  },
  "enforcement": {
    "dependencyPolicy": "rules/dependencies.json",
    "complexityPolicy": "rules/complexity.json",
    "typescriptPolicy": "rules/typescript.json",
    "commandPolicy": "rules/commands.json",
    "astPolicy": "rules/ast.json",
    "architecturePolicy": "rules/architecture.json",
    "securityPolicy": "rules/security.json"
  }
}
