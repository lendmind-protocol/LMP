  "specVersion": "1.0",
  "id": "lmp:mind:kernel-inspired-systems",
  "version": "1.0.0",
  "metadata": { "sourceRuleContractVersion": "1" },
  "name": "Kernel-Inspired Systems",
  "description": "Applicable systems-oriented Rust review with explicit limits and no external endorsement.",
  "modeDefaults": {
    "validation": "advisory",
    "network": "offline"
  },
  "author": {
    "kind": "official-maintainer",
    "displayName": "Lending-Mind Protocol Maintainers",
    "verified": false,
    "website": null
  },
  "provenance": {
    "sources": [
      {
        "title": "LMP implementation documented in the public repository README",
        "url": "https://raw.githubusercontent.com/lendmind-protocol/LMP/146a2df4c6b222634acbac4419fabce81249431e/README.md",
        "licenseNote": "Public repository documentation reference; no external endorsement claimed.",
        "evidenceTier": "primary",
        "rights": "public-documentation",
        "sourceType": "documentation",
        "accessMethod": "public-http",
        "contentDigest": "sha256:1031c93b138bca12d75d12afc4760e18dbb88bfa77ba0542b3b3a58ba66a41aa",
        "retentionPolicy": "metadata-only",
        "allowedUse": "evaluate-local-implementation"
      }
    ],
    "attributionRequired": false
  },
  "philosophy": {
    "principles": [
      "Applicable systems-oriented Rust review with explicit limits and no external endorsement.",
      "Report unsupported scope instead of silently passing it."
    ],
    "tradeoffs": [
      "A complexity cap can require more small functions and explicit error paths.",
      "Static evidence is bounded and does not replace human review."
    ],
    "decisionRules": [
      "Handle errors at the boundary where recovery is possible.",
      "Require evidence before quality, security, or performance claims."
    ],
    "antiPatterns": [
      "RAW_MACRO_EXPANSION",
      "UNHANDLED_ERROR",
      "UNBOUNDED_COMMAND_OUTPUT",
      "UNREDACTED_ARTIFACT"
    ]
  },
  "capabilities": {
    "languages": [
      "rust",
      "python",
      "typescript",
      "javascript"
    ],
    "requiredAgentTools": [
      "read_file",
      "write_file",
      "execute_command",
      "search"
    ]
  },
  "enforcement": {
    "dependencyPolicy": "rules/dependencies.json",
    "complexityPolicy": "rules/complexity.json",
    "typescriptPolicy": "rules/typescript.json",
    "commandPolicy": "rules/commands.json",
    "astPolicy": "rules/ast.json",
    "architecturePolicy": "rules/architecture.json",
    "securityPolicy": "rules/security.json"
  }
}
