{
  "name": "@lending-mind/lmp",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lendmind-protocol/LMP.git",
    "directory": "packages/cli"
  },
  "homepage": "https://lmp-six.vercel.app/docs/reference/cli",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "profiles", "README.md"],
  "bin": { "lmp": "dist/bin.js" },
  "scripts": {
    "build": "node -e \"for (const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check src"
  },
  "dependencies": {
    "@lending-mind/sdk": "workspace:*",
    "@lending-mind/skill": "workspace:*",
    "commander": "^12.1.0"
  },
  "author": "Justinedevs",
  "maintainers": [{ "name": "Justinedevs" }],
  "publishConfig": { "access": "public" }
}
