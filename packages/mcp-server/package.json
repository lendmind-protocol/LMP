{
  "name": "@lending-mind/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "lending-mind-mcp": "dist/bin.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/bin.ts','dist/bin.ts')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check src"
  },
  "dependencies": {
    "@lending-mind/core": "workspace:*",
    "@lending-mind/evaluator": "workspace:*",
    "@lending-mind/registry": "workspace:*",
    "@lending-mind/skill-compiler": "workspace:*",
    "@lending-mind/skill-schema": "workspace:*",
    "zod": "^3.24.1"
  }
}
