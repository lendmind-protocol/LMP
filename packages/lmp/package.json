{
  "name": "lmp",
  "version": "0.1.0",
  "description": "The npx launcher for the Lending-Mind Protocol CLI.",
  "type": "module",
  "bin": {
    "lmp": "dist/bin.js"
  },
  "files": ["dist", "README.md"],
  "dependencies": {
    "@lending-mind/lmp": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"for (const p of ['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pretest": "pnpm --filter @lending-mind/lmp build",
    "test": "node --test bin.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lendmind-protocol/LMP.git",
    "directory": "packages/lmp"
  },
  "license": "Apache-2.0"
}
