# Pinata: https://app.pinata.cloud/developers/api-keys
# Create an API key with file upload permission and copy its JWT.
PINATA_JWT=replace-with-a-scoped-pinata-jwt

# Pinata group URL: https://app.pinata.cloud/ipfs/groups/<GROUP_ID>
PINATA_GROUP_ID=replace-with-your-pinata-group-id

# Optional. Leave this unset on the free plan.
# PINATA_GATEWAY_DOMAIN=gateway.pinata.cloud
