{
  "name": "lending-mind-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "lmp": "pnpm --filter @lending-mind/cli exec lmp",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "vitest run --config vitest.config.ts tests/e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "generate:docs": "tsx scripts/generate-docs.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@lending-mind/skill-schema": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@changesets/cli": "^2.27.11",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
